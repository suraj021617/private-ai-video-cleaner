# Application
APP_NAME="Private AI Video Cleaner"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS (comma-separated). Credentials require explicit origins (not *).
CORS_ORIGINS=http://localhost:3000

# SQLite by default; use postgresql+asyncpg://... for production
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Storage (relative to backend/ when using default run scripts)
STORAGE_ROOT=../storage
MAX_UPLOAD_BYTES=536870912
UPLOAD_CHUNK_SIZE=5242880

# Auth — MUST use a long random secret in any real deployment
SECRET_KEY=change-me-in-production-use-long-random-string
SESSION_COOKIE_NAME=pavc_session
CSRF_COOKIE_NAME=pavc_csrf
SESSION_TTL_MINUTES=10080
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

ALLOWED_VIDEO_EXTENSIONS=mp4,mov,m4v,webm,mkv
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/quicktime,video/webm,video/x-matroska,application/octet-stream

# LaMa AI inpainting
LAMA_MODEL_DIR=../models/lama
LAMA_PREFER_GPU=true
LAMA_PADDING=64
LAMA_BLEND_STRENGTH=1.0
LAMA_FEATHER_RADIUS=12
LAMA_CPU_THREADS=0
